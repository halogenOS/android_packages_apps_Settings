<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="@dimen/about_header_padding"
    android:paddingBottom="@dimen/about_header_padding">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/about_header_logo_height"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        android:src="@drawable/halogenos_banner" />

    <!-- The bottom padding is below the device name even when the maintainer line is gone. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/about_header_name_bottom_padding">

        <TextView
            android:id="@+id/device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingTop="@dimen/about_header_name_top_padding"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/maintainers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="@dimen/about_header_line_spacing"
            android:textColor="@*android:color/materialColorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/about_header_section_margin"
        android:orientation="horizontal">

        <include
            android:id="@+id/android_version_card"
            layout="@layout/about_device_version_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/about_version_card_margin"
            android:layout_weight="1"
            android:theme="@style/ThemeOverlay.AboutVersionCard.Primary" />

        <include
            android:id="@+id/rom_version_card"
            layout="@layout/about_device_version_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/about_version_card_margin"
            android:layout_weight="1"
            android:theme="@style/ThemeOverlay.AboutVersionCard.Secondary" />
    </LinearLayout>

    <!-- The rows of about_device_info_row are added in code. -->
    <LinearLayout
        android:id="@+id/info_card"
        style="@style/AboutCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/about_header_section_margin"
        android:backgroundTint="@*android:color/materialColorSurfaceBright"
        android:divider="@drawable/about_info_divider"
        android:orientation="vertical"
        android:showDividers="middle" />

    <LinearLayout
        android:id="@+id/more_card"
        style="@style/AboutCard.Clickable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/about_header_card_margin"
        android:backgroundTint="@*android:color/materialColorSurfaceBright"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/about_phone_more"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right_24dp" />
    </LinearLayout>
</LinearLayout>
