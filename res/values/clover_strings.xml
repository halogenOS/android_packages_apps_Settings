<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Keybox Data -->
    <string name="keybox_data_title">Select keybox XML to spoof</string>
    <string name="keybox_data_summary">Select the keybox XML used for system-wide key attestation spoofing. Click delete to reset keybox data.</string>

    <!-- Attestation spoofing toggle -->
    <string name="attestation_spoof_title">Attestation spoofing</string>
    <string name="attestation_spoof_summary">Spoof key attestation and build properties so Play Integrity can pass. Has no effect on devices with OEM-verified boot. Reboot required for changes to take effect.</string>
    <string name="attestation_spoof_apps_title">Spoof for specific apps</string>
    <plurals name="attestation_spoof_apps_summary">
        <item quantity="one">%d app selected. Takes effect for newly started apps.</item>
        <item quantity="other">%d apps selected. Takes effect for newly started apps.</item>
    </plurals>

    <!-- Device identity rotation -->
    <string name="android_id_rotation_title">Rotate device identity</string>
    <string name="android_id_rotation_gms_id">GMS androidId: %1$s</string>
    <string name="android_id_rotation_os_id">OS androidId: %1$s</string>
    <string name="android_id_rotation_ssaid">GMS SSAID: %1$s</string>
    <string name="android_id_rotation_unknown">unknown</string>
    <string name="android_id_rotation_override_active">(override)</string>
    <string name="android_id_rotation_stored_hidden">stored (hidden by GMS)</string>
    <string name="android_id_rotation_ssaid_unreadable">only visible to GMS itself</string>
    <string name="android_id_rotation_reassign_active">fresh identity active (serial/IMEI shifted)</string>
    <string name="android_id_rotation_dialog_message">Requests a fresh androidId from Google: Play services forgets its current one and Google assigns a new ID on the next checkin — the same as setting up a new device. The synthetic serial and IMEI shift with it. Play services and Play Store are restarted. Reset clears the rotation state (a reassigned ID itself stays).</string>
    <string name="android_id_rotation_rotate">Rotate</string>
    <string name="android_id_rotation_reset">Reset</string>

</resources>
