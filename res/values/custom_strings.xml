<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="custom_rom_version">halogenOS version</string>
    <string name="custom_rom_build_version">Build version</string>
    <string name="vendor_security_patch">Vendor security update</string>
    <plurals name="device_info_device_maintainers_title">
        <item quantity="one">Device maintainer</item>
        <item quantity="other">Device maintainers</item>
    </plurals>

    <!-- About phone: line under the device name that shows the people who maintain the build for it -->
    <string name="maintained_by">Maintained by <xliff:g id="names" example="Jane Doe, John Roe">%s</xliff:g></string>
    <!-- About phone: card that opens the page with the remaining device details, and the title of that page -->
    <string name="about_phone_more">More</string>
    <!-- About phone, More page: title of the group with the firmware versions of the device, such as baseband -->
    <string name="firmware_information">Firmware information</string>
    <!-- About phone, More page: title of the item and page that show the live system audio path [CHAR LIMIT=60] -->
    <string name="audio_information_title">Audio information</string>
    <!-- About phone: time since the device started, then the share of that time the device spent in deep sleep -->
    <string name="uptime_with_deep_sleep"><xliff:g id="uptime" example="3:12:45">%1$s</xliff:g> (Deep sleep: <xliff:g id="percentage" example="61%">%2$s</xliff:g>)</string>
    <!-- About phone: label of the SELinux mode of the device -->
    <string name="selinux_status">SELinux status</string>
    <string name="selinux_status_disabled">Disabled</string>
    <string name="selinux_status_permissive">Permissive</string>
    <string name="selinux_status_enforcing">Enforcing</string>

    <string name="custom_rom_banner_purpose" translatable="false">The logo of the custom ROM</string>
    <string name="custom_rom_version_purpose" translatable="false">The version of the custom ROM</string>
    <string name="custom_rom_build_version_purpose" translatable="false">The build version of the custom ROM</string>
    <string name="vendor_security_patch_purpose" translatable="false">The date of the last vendor security update</string>
    <string name="device_maintainer_purpose" translatable="false">The people who maintain the build for this device</string>
    <string name="my_device_info_more_pref_screen_purpose" translatable="false">Allows users to view the device details not shown by the header of About phone, such as the phone number, baseband version, model, IMEI, hardware identifiers and legal information.</string>

    <string name="force_allow_hbm_title">Force allow HBM</string>
    <string name="force_allow_hbm_summary">
            Bypasses HBM checks and always allows max brightness.
            Prolonged use of max brightness may cause permanent damage or burn-in to the screen.
            Consumes more energy when HBM is active.
    </string>

    <!-- [CHAR LIMIT=60] Name of setting that dims the UI further -->
    <string name="black_ui_mode">Dimmed theme</string>

    <!-- Search keywords for dimmed theme settings [CHAR LIMIT=NONE] -->
    <string name="keywords_black_ui_mode">theme, black, dark, oled, amoled, dimmed</string>

    <!-- Sound & vibration: title of the row and page, which set for each output device whether it switches to the format of a track playing alone [CHAR LIMIT=40] -->
    <string name="output_format_title">Output format</string>
    <!-- Sound & vibration: summary of the Output format row, the number of devices that switch automatically out of all devices listed on the page, in the form chosen by the number of all devices [CHAR LIMIT=NONE] -->
    <plurals name="output_format_summary">
        <item quantity="one"><xliff:g id="switching" example="1">%1$d</xliff:g>/<xliff:g id="total" example="1">%2$d</xliff:g> device switches automatically</item>
        <item quantity="other"><xliff:g id="switching" example="3">%1$d</xliff:g>/<xliff:g id="total" example="4">%2$d</xliff:g> devices switch automatically</item>
    </plurals>
    <!-- Output format page: text at the top of the page [CHAR LIMIT=NONE] -->
    <string name="output_format_intro">When only one track is playing, the current output device is automatically switched to the audio format of the source, if enabled here.</string>
    <!-- Output format page: title of the group of output devices connected now [CHAR LIMIT=40] -->
    <string name="output_format_available_now">Available now</string>
    <!-- Output format page: title of the group of output devices that were connected before and are not connected now [CHAR LIMIT=40] -->
    <string name="output_format_used_before">Used before</string>
    <!-- Output format page: note below the device list [CHAR LIMIT=NONE] -->
    <string name="output_format_footer">A device connected for the first time starts with switching on.</string>
    <!-- Output format page: kind of a device, shown below its name, for a Bluetooth headset or speaker [CHAR LIMIT=40] -->
    <string name="output_format_bluetooth">Bluetooth</string>
    <!-- Output format page: kind of a device, shown below its name, for a USB audio device [CHAR LIMIT=40] -->
    <string name="output_format_usb_dac">USB DAC</string>
    <!-- Output format page: kind of a device, shown below its name, for the speaker of the phone [CHAR LIMIT=40] -->
    <string name="output_format_built_in">Built in</string>
    <!-- Output format page: kind of a device, shown below its name, for headphones on the headphone jack or a USB-C analog adapter [CHAR LIMIT=40] -->
    <string name="output_format_wired">Wired</string>
    <!-- Output format page: name of the headphones on the headphone jack or a USB-C analog adapter [CHAR LIMIT=40] -->
    <string name="output_format_wired_headphones">Wired headphones</string>
    <!-- Output format page: name of the speaker of the phone [CHAR LIMIT=40] -->
    <string name="output_format_phone_speaker">Phone speaker</string>
</resources>
