    <!-- About phone: time since the device started, then the share of that time the device spent in deep sleep -->
    <string name="uptime_with_deep_sleep"><xliff:g id="uptime" example="3:12:45">%1$s</xliff:g> (Deep sleep: <xliff:g id="percentage" example="61%">%2$s</xliff:g>)</string>
