    <string name="force_allow_hbm_title">Force allow HBM</string>
    <string name="force_allow_hbm_summary">
            Bypasses HBM checks and always allows max brightness.
            Prolonged use of max brightness may cause permanent damage or burn-in to the screen.
            Consumes more energy when HBM is active.
    </string>

    <!-- [CHAR LIMIT=60] Name of setting that dims the UI further -->
