<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:settings="http://schemas.android.com/apk/res-auto"
        android:key="misc_settings"
        android:title="@string/misc_settings_title">

        <!-- Google Play Integrity -->
        <com.android.settings.custom.preference.SystemPropertySwitchPreference
            android:key="persist.sys.pihooks.pi"
            android:title="@string/pi_spoof_title"
            android:summary="@string/pi_spoof_summary"
            android:defaultValue="true" />

        <!-- Sussybox fail prop -->
        <com.android.settings.custom.preference.SystemPropertySwitchPreference
            android:key="persist.sys.sussybox.fail"
            android:title="@string/sussybox_debug_title"
            android:summary="@string/sussybox_debug_summary"
            android:defaultValue="false" />

        <!-- OS Version Override -->
        <com.android.settings.clover.misc.OsVersionPreference
            android:key="os_version_override"
            android:title="@string/os_version_override_title"
            android:dialogTitle="@string/os_version_dialog_title"
            android:dialogMessage="@string/os_version_dialog_message" />
   
</PreferenceScreen>
