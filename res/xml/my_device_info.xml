<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="my_device_info_pref_screen"
    android:title="@string/about_settings">

    <!-- Hero header with logo, info cards -->
    <com.android.settingslib.widget.LayoutPreference
        android:key="halogenos_about_header"
        android:order="0"
        android:layout="@layout/halogenos_about_header"
        android:selectable="false" />

    <!-- Hidden build number preference for dev mode tap counter -->
    <Preference
        android:key="build_number"
        android:order="1"
        android:title="@string/build_number"
        android:summary="@string/summary_placeholder"
        settings:isPreferenceVisible="false"
        settings:enableCopying="true"
        settings:controller="com.android.settings.deviceinfo.BuildNumberPreferenceController"/>

    <!-- Hidden — navigation handled by header More button -->
    <Preference
        android:key="about_phone_more"
        android:order="50"
        android:title="@string/about_phone_more"
        settings:isPreferenceVisible="false"
        android:fragment="com.android.settings.deviceinfo.aboutphone.MyDeviceInfoMoreFragment"/>

</PreferenceScreen>
